{
  "name": "sovexxa/sovexxa-society-management",
  "description": "Sovexxa Society Management WordPress plugin",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=7.4",
    "dompdf/dompdf": "^3.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "Sovexxa\\": "includes/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
