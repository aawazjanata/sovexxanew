<?xml version="1.0"?>
<ruleset name="Sovexxa">
  <description>PHPCS rules for Sovexxa plugin (WordPress minimal)</description>
  <rule ref="PSR12"/>
  <rule ref="WordPress"/>
  <arg name="encoding" value="utf-8"/>
  <file>./includes</file>
  <file>./admin</file>
  <file>./templates</file>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
</ruleset>